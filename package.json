{
  "name": "spotr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "spotr": "src/main.ts"
  },
  "scripts": {
    "typecheck": "effect-tsgo tsc -p tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run --passWithNoTests",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.4",
    "effect": "4.1.4"
  },
  "devDependencies": {
    "@effect/tsgo": "0.70.0",
    "@effect/vitest": "4.1.4",
    "@oxlint/plugins": "1.94.0",
    "lefthook": "2.2.2",
    "oxlint": "1.94.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
