{
  "name": "spotr-workspace",
  "private": true,
  "description": "Control the Spotify desktop app from your terminal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/201549BL/spotr.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/core",
    "packages/cli"
  ],
  "scripts": {
    "typecheck": "effect-tsgo tsc -p tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "build:bin": "bun build --compile packages/cli/src/main.ts --outfile dist/spotr",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@effect/tsgo": "0.70.0",
    "@effect/vitest": "4.1.4",
    "@oxlint/plugins": "1.94.0",
    "bun": "1.4.5",
    "lefthook": "2.2.2",
    "oxlint": "1.94.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
